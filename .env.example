# Contrato de variáveis de ambiente do Caleida.
#
# A aplicação ainda inicia localmente sem banco.
# Este arquivo contém somente nomes e documentação; nunca valores reais.
# Nunca versione secrets, tokens, senhas, connection strings ou API keys.
# Variáveis NEXT_PUBLIC_* são expostas ao browser e devem ser deliberadamente públicas.
#
# Conexões futuras / tooling:
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
#
# Gate primário em PostgreSQL 18 descartável:
# CALEIDA_DB_TARGET=ephemeral
#
# Gate adicional em branch Neon isolada, quando aplicável:
# CALEIDA_DB_TARGET=neon-isolated
# CALEIDA_NEON_BRANCH_ID=
#
# Promoção deliberada para a baseline non-production:
# CALEIDA_DB_TARGET=baseline
# CALEIDA_NEON_BRANCH_ID=br-restless-cherry-awpcwy6r
# CALEIDA_ALLOW_BASELINE_MIGRATIONS=YES
#
# Não adicione credenciais Neon a NEXT_PUBLIC_*.
