{
  "name": "caleida",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrations:check": "node database/scripts/validate-migrations.mjs",
    "db:migrate": "node database/scripts/migrate.mjs",
    "db:test": "node database/scripts/test.mjs",
    "db:bootstrap-owner": "node database/scripts/bootstrap-owner.mjs",
    "verify": "npm run db:migrations:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:db": "npm run db:migrate && npm run db:test"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
